# Firebase (ileadit-app project)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ileadit-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (src/lib/appCheck.ts) — see that file's header comment for the
# one-time setup steps. The reCAPTCHA v3 site key is NOT secret (it is
# shipped to the browser); the debug token below IS per-machine and must
# only ever live in .env.local, never here or in any committed file.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# ── Stripe (per-competition billing) ────────────────────────────────────
# TEST MODE ONLY for now: the secret key must start `sk_test_`. See
# src/lib/billing/stripeServer.ts — a live key is refused unless
# STRIPE_ALLOW_LIVE_MODE is deliberately set to "true".
#
# Real values live ONLY in .env.local, which is gitignored. Never put a key
# in this file.
#
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is currently unused by any code on this
# branch: Checkout is hosted, so the browser just follows session.url and
# needs no Stripe JS. Kept here because the pricing page or a future
# embedded element will want it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` when
# developing, or the endpoint's signing secret in the dashboard. Without it
# the webhook returns 503 and records nothing — it never skips the check.
STRIPE_WEBHOOK_SECRET=
# Set to "true" ONLY when real charges are genuinely intended. Leave unset.
STRIPE_ALLOW_LIVE_MODE=

# Absolute origin used to build Stripe Checkout's success/cancel URLs.
# Required by /api/billing/checkout; not inferred from request headers.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Engine billing endpoints (depends on the `feat/org-model` branch) ───
# How this repo reads an org's price band and records a paid competition.
# Neither endpoint exists yet — see src/lib/billing/engineBilling.ts for the
# exact contract they must satisfy (in particular: recordPaidCompetition
# MUST be idempotent on billingEventId). With these unset the checkout route
# returns 503 and the webhook asks Stripe to retry; nothing is ever silently
# treated as recorded.
ILEADIT_ENGINE_BILLING_URL=
# Service-to-service credential. Secret — .env.local only, never here.
ILEADIT_ENGINE_BILLING_TOKEN=

# Microsoft sign-in (src/lib/auth.ts, isMicrosoftSignInEnabled()) — leave
# unset/false until Paul has (a) created the Azure AD app registration and
# (b) configured it as the Microsoft OAuth provider in the Firebase console
# for the ileadit-app project. Setting this to "true" before then does NOT
# make Microsoft sign-in work; it only removes the deliberate
# "unavailable" short-circuit, so calls would fail against an unconfigured
# provider instead of failing fast and legibly. See src/lib/auth.ts.
NEXT_PUBLIC_MICROSOFT_AUTH_ENABLED=
