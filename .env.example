# Firebase (ileadit-app project)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ileadit-app
# Required for competition artwork upload (src/lib/artworkUpload.ts).
# Without it the rest of the app still works — getFirebaseStorage() throws
# by name and the upload field shows "uploads aren't configured".
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (src/lib/appCheck.ts) — see that file's header comment for the
# one-time setup steps. The reCAPTCHA v3 site key is NOT secret (it is
# shipped to the browser); the debug token below IS per-machine and must
# only ever live in .env.local, never here or in any committed file.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Microsoft sign-in (src/lib/auth.ts, isMicrosoftSignInEnabled()) — leave
# unset/false until Paul has (a) created the Azure AD app registration and
# (b) configured it as the Microsoft OAuth provider in the Firebase console
# for the ileadit-app project. Setting this to "true" before then does NOT
# make Microsoft sign-in work; it only removes the deliberate
# "unavailable" short-circuit, so calls would fail against an unconfigured
# provider instead of failing fast and legibly. See src/lib/auth.ts.
NEXT_PUBLIC_MICROSOFT_AUTH_ENABLED=
